# Supabase: Project Settings > Database > Connection string (URI). Paste it here.
# Example: postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./zentriq.db
# Any long random string. Used to sign JWT tokens.
JWT_SECRET=change-this-to-a-long-random-string
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=http://localhost:5173

# Google Gemini API Key for AI PM Copilot
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Resend API Key for Email Center, Meeting Invites & Task Assignment
# Get a key at: https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=Zentriq
APP_BASE_URL=http://localhost:5173
